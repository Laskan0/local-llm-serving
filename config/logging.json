{
  "version": 1,
  "disable_existing_loggers": true,
  "formatters": {"private": {"()": "privacy_logging.SafeJsonFormatter"}},
  "handlers": {
    "private": {"class": "logging.StreamHandler", "formatter": "private", "stream": "ext://sys.stdout"},
    "discard": {"class": "logging.NullHandler"}
  },
  "root": {"handlers": ["private"], "level": "INFO"},
  "loggers": {
    "project.audit": {"handlers": ["private"], "level": "INFO", "propagate": false},
    "vllm": {"handlers": ["private"], "level": "INFO", "propagate": false},
    "vllm.logging_utils.dump_input": {"handlers": ["discard"], "level": "CRITICAL", "propagate": false},
    "uvicorn": {"handlers": ["private"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["private"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": ["discard"], "level": "CRITICAL", "propagate": false},
    "torch": {"handlers": ["private"], "level": "INFO", "propagate": false},
    "asyncio": {"handlers": ["private"], "level": "INFO", "propagate": false}
  }
}
